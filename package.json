{
  "name": "kitchen-eyes",
  "version": "1.0.0",
  "description": "Kitchen-Eyes: Keep an eye on your kitchen",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "test": "jest",
    "test:unit": "jest --testRegex='^(?!.*\\.int\\.spec\\.(t|j)s$).*\\.spec\\.(t|j)s$'",
    "test:e2e": "jest --testRegex='.*\\.int\\.spec\\.(t|j)s$'",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/static": "^8.2.0",
    "@fastify/swagger": "^9.5.1",
    "@keyv/redis": "^5.1.0",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.0.21",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.21",
    "@nestjs/platform-fastify": "^11.0.21",
    "@nestjs/swagger": "^11.0.3",
    "@nestjs/typeorm": "^11.0.0",
    "cache-manager": "^7.1.1",
    "cacheable": "^1.10.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "keyv": "^5.2.2",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.25"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.0.21",
    "@testcontainers/postgresql": "^11.5.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.12",
    "@types/pg": "^8.15.5",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "fastify": "^5.5.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "testcontainers": "^10.10.3",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "engineStrict": true,
  "packageManager": "pnpm@7.2.1"
